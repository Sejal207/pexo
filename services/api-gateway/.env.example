DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<dbname>?ssl=require
DB_SCHEMA=public
SECRET_KEY=supersecretjwtkey_change_in_production_Pexo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
# false for local http dev; true once served over https
COOKIE_SECURE=false

# Must be an exact origin (no "*") since cookies require allow_credentials
FRONTEND_ORIGIN=http://localhost:5175

HR_SERVICE_URL=http://localhost:8001
ATTENDANCE_SERVICE_URL=http://localhost:8002
PAYROLL_SERVICE_URL=http://localhost:8003
